{
	"name": "textblock",
	"version": "0.12.3",
	"bugs": {
		"url": "https://github.com/glyphic-co/textblock/issues"
	},
	"description": "A javascript tool for adjusting size, leading, and grades to cast continuously responsive typography.",
	"homepage": "https://textblock.io",
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"license": "MIT",
	"lint-staged": {
		"*": "prettier --ignore-unknown --write",
		"./**/*.{js,ts}": [
			"eslint"
		]
	},
	"main": "textblock.min.js",
	"publishConfig": {
		"access": "public",
		"@glyphic:registry": "https://registry.npmjs.org"
	},
	"repository": "https://github.com/glyphic-co/textblock",
	"README": "README.md",
	"scripts": {
		"build": "grunt",
		"changeset": "changeset",
		"clean": "rm -rf coverage node_modules package-lock.json && npm cache clean --force",
		"format": "prettier . --ignore-unknown --write",
		"lint": "eslint",
		"postversion": "node -e \"const pkg = require('./package.json'); require('child_process').execSync('git tag v' + pkg.version);\" || echo 'Tag already exists. Skipping...'",
		"pre-commit": "lint-staged",
		"prepare": "husky",
		"release": "changeset publish",
		"start": "grunt watch",
		"tc": "tsc --noEmit",
		"version": "changeset version"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.27.8",
		"@types/eslint": "^8.56.12",
		"@types/node": "^22.5.4",
		"@typescript-eslint/eslint-plugin": "^8.4.0",
		"@typescript-eslint/parser": "^8.4.0",
		"eslint": "^8.57.0",
		"eslint-import-resolver-typescript": "^3.6.3",
		"eslint-plugin-import": "^2.29.1",
		"grunt": "^1.0.4",
		"grunt-contrib-uglify": "^4.0.1",
		"grunt-contrib-watch": "^1.1.0",
		"husky": "^9.1.5",
		"lint-staged": "^15.2.10",
		"prettier": "^3.3.3",
		"ts-node": "^10.9.2",
		"typescript": "^5.6.2"
	}
}
